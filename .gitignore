# Build output. The Tailwind binary is downloaded on demand by `make css`.
/bin/

# The default SQLite database and its write-ahead log.
invctl.db
invctl.db-wal
invctl.db-shm

# Coverage output.
coverage.out

# Profiling leftovers. `go test -cpuprofile` writes the compiled test binary
# beside the profile so pprof can resolve symbols, and a 29MB one was committed
# and pushed by a `git add -A` during WP-I3 before this rule existed.
*.test
*.prof
cpu.out
mem.out

# Browser tooling scratch.
/.playwright-mcp/
shot-*.png

# web/static/app.css is generated but *is* committed: the Go build embeds it,
# and requiring the Tailwind binary to build the binary would defeat the point
# of having no Node runtime in the pipeline.

# Playwright/E2E local artefacts. auth-state.json holds a LIVE session cookie
# for whatever instance the run authenticated against -- scratch only, never
# committed, even though the demo's own credentials are public by design.
tests/e2e/auth-state.json
tests/e2e/**/auth-state.json
tests/e2e/test-results/
tests/e2e/playwright-report/
**/shot-*.png

# Node.js is a test-time dependency of tests/e2e only -- never the build. See
# docs/E2E.md. package-lock.json IS committed so the pinned Playwright version
# is reproducible; node_modules is fetched from it, never checked in.
tests/e2e/node_modules/
